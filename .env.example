# ── Database ──────────────────────────────────────────────────
# SQLite (default):
# DATABASE_URL=sqlite:///C:/ProgramData/DELCA/delca.db
#
# PostgreSQL (future):
# DATABASE_URL=postgresql://user:password@localhost:5432/delca
#
# Echo SQL queries (development only)
# DB_ECHO=false

# ── Paths (overrides for production install) ─────────────────
# LOG_DIR=C:/ProgramData/DELCA/logs
# BACKUP_DIR=C:/ProgramData/DELCA/backups
# DATA_DIR=C:/ProgramData/DELCA/data

# ── Security ─────────────────────────────────────────────────
# SECRET_KEY=change-me-in-production
