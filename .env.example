# ── Database ──────────────────────────────────────────────────
# SQLite (default):
# DATABASE_URL=sqlite:///C:/ProgramData/DELCA/delca.db
#
# PostgreSQL (future):
# DATABASE_URL=postgresql://user:password@localhost:5432/delca
#
# Echo SQL queries (development only)
# DB_ECHO=false

# ── Paths (overrides for production install) ─────────────────
# LOG_DIR=C:/ProgramData/DELCA/logs
# BACKUP_DIR=C:/ProgramData/DELCA/backups
# DATA_DIR=C:/ProgramData/DELCA/data

# ── Security ─────────────────────────────────────────────────
# SECRET_KEY=change-me-in-production

# ── WhatsApp Cloud API + Agente IA ─────────────────────────────
# Token de acceso permanente de la app Meta (system user token).
# HOWTO: developers.facebook.com → tu app → WhatsApp → API Setup.
# WHATSAPP_TOKEN=
# ID del número de teléfono (phone_number_id) de Meta Business.
# WHATSAPP_PHONE_ID=
# Token de verificación del webhook (lo defines tú; se repite en
# Meta → app → WhatsApp → Configuration → Verify token).
# WHATSAPP_VERIFY_TOKEN=
# App secret (Meta → app → Settings → Basic → App secret).
# WHATSAPP_APP_SECRET=
# Versión de la Graph API (dejar la vigente, default v21.0).
# WHATSAPP_GRAPH_VERSION=v21.0
#
# Agente IA (OpenAI):
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MAX_TOKENS=300
#
# Procesamiento automático de mensajes entrantes:
#   false = recibe y registra pero NO responde automáticamente (modo seguro).
#   true  = el agente responde a los clientes.
# WHATSAPP_AGENT_ENABLED=false
# Puerto local del webhook (el túnel público apunta aquí).
# WHATSAPP_WEBHOOK_PORT=9090
